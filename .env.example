# Copy this file to .env and fill in your own values.
# .env is git-ignored -- never commit real credentials.

# --- Trello -------------------------------------------------------------
# API key + token from https://trello.com/power-ups/admin (token starts with ATTA)
TRELLO_API_KEY=
TRELLO_TOKEN=
# The board to sync (the id from the board's .json URL, not its short link)
TRELLO_BOARD_ID=

# --- Notion -------------------------------------------------------------
# Internal integration secret from https://www.notion.so/my-integrations
# Share BOTH databases with the integration, or the API returns 404s.
NOTION_TOKEN=
# data_source_id values (not database ids) for the two linked databases
NOTION_TASKS_DATA_SOURCE_ID=
NOTION_PROJECTS_DATA_SOURCE_ID=

# --- Optional -----------------------------------------------------------
# Trello list a new card lands in when a new Notion task has no Status yet
# DEFAULT_LIST_NAME=Backlog
# Set to true only after confirming the Tasks database has this property
# SYNC_DESCRIPTION=false

# Override Notion property names if your databases use different ones
# NOTION_TITLE_PROPERTY=Name
# NOTION_STATUS_PROPERTY=Status
# NOTION_DUE_DATE_PROPERTY=Due Date
# NOTION_PROJECT_PROPERTY=Project
# NOTION_DESCRIPTION_PROPERTY=Description
# NOTION_PROJECTS_TITLE_PROPERTY=Name

# Postgres connection string -- set automatically by the Heroku Postgres
# add-on. Leave unset locally to use a SQLite file instead.
# DATABASE_URL=
